+    const uint src_idx_b = get_boffset() + i23 * p.nb13 + i22 * p.nb12 + i21 * p.nb11 + i20 * p.nb10;
+    const uint dst_idx   = get_doffset() + i23 * p.nb23 + i22 * p.nb22 + i21 * p.nb21 + i20 * p.nb20;
+
+    // re-mapping (linear to tileK_first)
+    uint idx_in, row_in, col_in, kk, idx_out;
+    // Assuming k % tileK == 0
+    const uint tileK = 16;
+    uint k = p.ne00;      // K = ne0 -> from vk_op_glu_push_constants(...)  ne00 = dst->ne[0]
+    uint m_or_n = p.ne21; // N = ne1 -> from vk_op_glu_push_constants(...)  ne21 = dst->ne[1]
+
+    idx_in = dst_idx;
+    row_in = idx_in / k;        
+    col_in = (idx_in % k) / tileK;
+    kk = idx_in % tileK;
+    idx_out = tileK * (col_in * m_or_n + row_in) + kk; 
+
+    data_d[idx_out] = float(op(float(data_a[src_idx_a]), float(data_b[src_idx_b])));
+}
